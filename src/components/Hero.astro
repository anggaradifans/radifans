---
import { profile } from '../data/profile';
---

<section id="about" class="hero">
  <div class="container hero__inner">
    <div class="hero__visual" aria-label="Aether Pixel workspace scene">
      <div class="sprite-frame">
        <div class="hero__terminal">
          <span>Work snapshot</span>
          <strong>React / Node / Java</strong>
          <span>Trust, health, finance</span>
        </div>
      </div>
      <div class="hero__badges">
        {profile.roles.map((role) => (
          <span class="class-badge">{role}</span>
        ))}
      </div>
    </div>

    <div class="hero__stat-card reveal">
        <div class="dialog-box">
          <p class="hero__eyebrow font-mono">Software engineer · Full-stack product work</p>
          <div class="dialog-box__header">
          <h1 class="dialog-box__name font-display">{profile.name}</h1>
          <p class="dialog-box__title font-mono">{profile.title}</p>
        </div>

        <div class="dialog-box__body">
          {profile.bio.map((para) => (
            <p class="dialog-box__bio">{para}</p>
          ))}
        </div>

          <div class="hero__actions">
          <a href={profile.cv} target="_blank" rel="noopener noreferrer" class="btn-primary" aria-label="View CV">
            Download CV
          </a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary" aria-label="LinkedIn profile">
            LinkedIn
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn-secondary" aria-label="GitHub profile">
            GitHub
          </a>
          <a href="#contact" class="btn-secondary hero__contact-link" aria-label="Contact me">
            Get in touch
          </a>
          </div>

          <div class="hero__proof" aria-label="Engineering focus">
            <div class="hero__proof-item">
              <span class="hero__proof-label font-mono">Builds for</span>
              <strong>Digital trust · Health · Finance</strong>
            </div>
            <div class="hero__proof-item">
              <span class="hero__proof-label font-mono">Works across</span>
              <strong>Interface · API · Operations</strong>
            </div>
          </div>
        </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92dvh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 80px 0 auto 0;
    height: 44%;
    background:
      linear-gradient(90deg, transparent 0 16px, rgba(79,255,176,0.08) 16px 20px, transparent 20px 72px),
      linear-gradient(180deg, rgba(191,90,242,0.12), transparent 70%);
    opacity: 0.55;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.45fr);
    gap: var(--space-12);
    align-items: center;
    width: 100%;
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }
  .sprite-frame {
    width: min(100%, 330px);
    aspect-ratio: 0.78;
    background: 
      linear-gradient(180deg, rgba(12, 14, 24, 0.12), rgba(12, 14, 24, 0.76)),
      url('/images/gaming-room.webp') center/cover no-repeat;
    border: 2px solid var(--outline);
    outline: 1px solid var(--primary-container);
    outline-offset: -8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 0 60px rgba(0,0,0,0.6);
  }
  .sprite-frame::after {
    content: '';
    position: absolute;
    inset: auto 24px 24px 24px;
    height: 8px;
    background: var(--primary-container);
    box-shadow: 0 0 18px var(--primary-fixed-dim);
  }
  .hero__terminal {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-12);
    display: grid;
    gap: var(--space-1);
    background: rgba(12, 14, 24, 0.88);
    border: 2px solid var(--outline);
    padding: var(--space-4);
    font-family: var(--font-mono);
    color: var(--on-surface-variant);
    font-size: 18px;
  }
  .hero__terminal strong {
    color: var(--primary-container);
    font-family: var(--font-ui);
    font-size: 15px;
  }

  .hero__badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .class-badge {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--secondary-fixed-dim);
    border: 2px solid var(--secondary-container);
    padding: 6px 10px;
    letter-spacing: 0;
  }

  .dialog-box {
    background: var(--surface-container);
    border: 2px solid var(--outline);
    padding: var(--space-8);
    position: relative;
  }
  .dialog-box__header { margin-bottom: var(--space-6); }
  .hero__eyebrow {
    color: var(--tertiary-fixed);
    font-size: 13px;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-4);
    text-transform: uppercase;
  }
  .dialog-box__name {
    font-size: clamp(28px, 3.4vw, 42px);
    color: var(--primary-container);
    margin-bottom: var(--space-3);
    line-height: 1.35;
  }
  .dialog-box__title {
    font-size: 22px;
    color: var(--secondary-fixed-dim);
  }
  .dialog-box__body { margin-bottom: var(--space-6); }
  .dialog-box__bio {
    font-size: 14px;
    color: var(--on-surface-variant);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .hero__contact-link { border-width: 2px; padding: 11px 20px; }
  .hero__proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 2px solid var(--outline-variant);
  }
  .hero__proof-item {
    display: grid;
    gap: var(--space-1);
  }
  .hero__proof-label {
    color: var(--secondary-fixed-dim);
    font-size: 12px;
    text-transform: uppercase;
  }
  .hero__proof-item strong {
    color: var(--on-surface);
    font-size: 14px;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero__visual { align-items: center; }
    .hero__actions { justify-content: center; }
    .hero__proof { text-align: left; }
  }
  @media (max-width: 520px) {
    .hero {
      min-height: auto;
      padding-top: 104px;
    }
    .dialog-box {
      padding: var(--space-6);
    }
    .hero__actions a {
      width: 100%;
      justify-content: center;
      min-height: 44px;
    }
    .hero__proof { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  @keyframes sprite-idle {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
</style>
