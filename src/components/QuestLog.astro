---
import { experiences } from '../data/experience';
---

<section id="quest" class="quest-section">
  <div class="container">
    <h2 class="section-heading reveal">Experience</h2>

    <div class="timeline">
      <div class="timeline__rope" aria-hidden="true"></div>

      {experiences.map((exp, i) => (
        <article class="quest-entry reveal" data-index={i}>
          <div class="quest-entry__node" aria-hidden="true">
            <span class="font-display">{i + 1}</span>
          </div>

          <div class="quest-card pixel-card">
            <div class="quest-card__header">
              <div>
                <h3 class="quest-card__company font-display">{exp.company}</h3>
                <p class="quest-card__meta font-mono">
                  {exp.position} <span class="quest-card__duration">{exp.duration}</span>
                </p>
              </div>
              <span class="level-badge font-display">
                {exp.duration}
              </span>
            </div>

            <div class="xp-row" aria-label={`Timeline marker ${i + 1} of ${experiences.length}`}>
              <span class="xp-label font-mono">Focus</span>
              <div class="xp-bar-track" role="progressbar" aria-valuenow={exp.level * 33} aria-valuemin={0} aria-valuemax={100}>
                <div
                  class="xp-bar-fill"
                  style={`--xp-width: ${Math.round((exp.level / 3) * 100)}%`}
                ></div>
              </div>
            </div>

            <div class="quest-card__tech">
              {exp.technologies.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>

            <button
              class="quest-card__toggle font-display"
              data-target={`quest-details-${i}`}
              aria-expanded="false"
              aria-controls={`quest-details-${i}`}
            >
              Read Details
            </button>

            <div class="quest-details" id={`quest-details-${i}`} hidden>
              <ul class="quest-card__desc">
                {exp.description.map((item) => (
                  <li><span class="desc-bullet font-mono">▸</span> {item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .quest-section { background: var(--surface-container-low); }

  .timeline {
    position: relative;
    padding-left: 48px;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .timeline__rope {
    position: absolute;
    left: 16px;
    top: 0; bottom: 0;
    width: 6px;
    background: repeating-linear-gradient(
      to bottom,
      var(--primary-container),
      var(--primary-container) 10px,
      var(--primary-fixed-dim) 10px,
      var(--primary-fixed-dim) 20px
    );
  }

  .quest-entry { position: relative; }
  .quest-entry__node {
    position: absolute;
    left: -48px;
    top: var(--space-6);
    width: 38px; height: 38px;
    background: var(--primary-container);
    border: 3px solid var(--on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    color: var(--on-primary);
  }

  .quest-card { transition: border-color 0.2s; }
  .quest-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .quest-card__company {
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 800;
    color: var(--primary-container);
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }
  .quest-card__meta { font-size: 18px; color: var(--on-surface-variant); }
  .quest-card__duration {
    color: var(--secondary-fixed-dim);
    display: inline-block;
    margin-left: var(--space-2);
  }

  .level-badge {
    font-size: 13px;
    font-weight: 800;
    color: var(--on-tertiary);
    background: var(--tertiary-container);
    padding: 4px 10px;
    border: 2px solid var(--tertiary-fixed-dim);
    white-space: nowrap;
    box-shadow: 3px 3px 0 var(--tertiary-fixed-dim);
  }

  .xp-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .xp-label {
    font-size: 16px;
    color: var(--primary-container);
    min-width: 36px;
  }
  .xp-bar-track { flex: 1; }

  .quest-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .quest-card__toggle {
    font-size: 13px;
    color: var(--secondary-fixed-dim);
    background: var(--surface-container-lowest);
    border: 2px solid var(--secondary-container);
    cursor: pointer;
    padding: 10px 12px;
    min-height: 44px;
    transition: color 0.15s;
  }
  .quest-card__toggle:hover { color: var(--primary-container); }
  .quest-card__toggle[aria-expanded="true"] { color: var(--primary-container); }

  .quest-details { margin-top: var(--space-4); }
  .quest-card__desc {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 2px solid var(--outline-variant);
    padding-top: var(--space-4);
  }
  .quest-card__desc li {
    font-size: 14px;
    color: var(--on-surface-variant);
    line-height: 1.7;
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .desc-bullet {
    font-size: 18px;
    color: var(--primary-container);
    flex-shrink: 0;
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .timeline { padding-left: 36px; }
    .quest-entry__node { left: -36px; width: 30px; height: 30px; font-size: 12px; }
    .quest-card {
      padding: var(--space-6);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.quest-card__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const detail   = document.getElementById(targetId);
      if (!detail) return;

      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      detail.hidden = isOpen;
      btn.textContent = isOpen ? 'Read Details' : 'Close Details';
    });
  });
</script>
