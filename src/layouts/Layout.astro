---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { profile } from '../data/profile';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Angga Radifan Sumarna | Full-Stack Software Engineer | radifans.my.id',
  description = `Full-Stack Software Engineer with ${new Date().getFullYear() - 2019} years experience in React, Node.js, TypeScript. Building scalable fintech, healthcare, and e-commerce web applications.`,
} = Astro.props;

// Derived from `site` in astro.config.mjs so the canonical host is defined in exactly one place.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL('/og-image.png', Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
    </style>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11131e" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — portfolio preview card`} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${title} — portfolio preview card`} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" as="image" href="/images/gaming-room.webp" fetchpriority="high" />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Subtle CRT scanline overlay for the Aether Pixel direction. -->
    <div class="scanline-overlay" aria-hidden="true"></div>

    <Navbar />

    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p><span class="font-mono">{profile.name}</span> · Software engineer building considered product systems.</p>
        <p class="font-mono">© {year} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              // XP bars
              const bars = entry.target.querySelectorAll('.xp-bar-fill');
              bars.forEach((bar) => bar.classList.add('animate'));
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  .site-footer { background: var(--surface-container-lowest); border-top: 2px solid var(--outline-variant); padding: var(--space-6) 0; }
  .site-footer__inner { display: flex; justify-content: space-between; gap: var(--space-4); color: var(--on-surface-variant); font-size: 13px; }
  .site-footer a { color: var(--primary-container); text-underline-offset: 3px; }
  @media (max-width: 600px) { .site-footer__inner { flex-direction: column; } }
</style>
