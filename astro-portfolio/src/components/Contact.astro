---
import { profile } from '../data/profile';
---

<section id="contact" class="contact-section">
  <div class="container">
    <h2 class="section-heading reveal">SAVE POINT — GET IN TOUCH</h2>

    <div class="contact-layout reveal">
      <!-- Form -->
      <div class="contact-form-wrap pixel-card">
        <p class="contact-form-wrap__sub font-mono">&gt; TRANSMIT A MESSAGE_</p>

        <form class="contact-form" id="contactForm" novalidate>
          <div class="form-group">
            <label class="pixel-label" for="contact-name">PLAYER NAME</label>
            <input
              class="pixel-input"
              type="text"
              id="contact-name"
              name="name"
              placeholder="Your full name"
              required
              autocomplete="name"
            />
          </div>

          <div class="form-group">
            <label class="pixel-label" for="contact-email">SIGNAL ADDRESS</label>
            <input
              class="pixel-input"
              type="email"
              id="contact-email"
              name="email"
              placeholder="your.email@example.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label class="pixel-label" for="contact-message">YOUR MESSAGE</label>
            <textarea
              class="pixel-input"
              id="contact-message"
              name="message"
              placeholder="Tell me about your project or opportunity..."
              rows={5}
              required
            ></textarea>
          </div>

          <button type="submit" class="btn-primary contact-submit" id="submitBtn">
            ✉ SEND MESSAGE ▶▶
          </button>

          <!-- Status messages -->
          <div class="contact-status" id="contactStatus" aria-live="polite" hidden>
            <span class="contact-status__text font-mono" id="statusText"></span>
          </div>
        </form>
      </div>

      <!-- CTA links -->
      <div class="contact-links">
        <h3 class="contact-links__heading font-display">QUICK LINKS</h3>

        <a href={profile.cv} download class="cta-link btn-primary" aria-label="Download Angga's CV">
          ⬇ DOWNLOAD CV
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="cta-link btn-secondary" aria-label="LinkedIn profile">
          in LINKEDIN
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="cta-link btn-secondary" aria-label="GitHub profile">
          🐙 GITHUB
        </a>
        <a href={`mailto:${profile.email}`} class="cta-link btn-secondary" aria-label="Send email">
          ✉ EMAIL
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--surface-container-lowest);
    padding-bottom: var(--space-24);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-8);
    align-items: start;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Form wrap */
  .contact-form-wrap__sub {
    font-size: 18px;
    color: var(--secondary-fixed-dim);
    margin-bottom: var(--space-6);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .form-group { display: flex; flex-direction: column; gap: var(--space-1); }
  textarea.pixel-input { resize: vertical; min-height: 120px; font-family: var(--font-mono); }
  .contact-submit { width: 100%; justify-content: center; font-size: 9px; }

  /* Status */
  .contact-status {
    padding: var(--space-3);
    background: var(--surface-container);
    border: 2px solid var(--outline);
  }
  .contact-status__text { font-size: 16px; }
  .contact-status.success { border-color: var(--primary-container); }
  .contact-status.success .contact-status__text { color: var(--primary-container); }
  .contact-status.error   { border-color: var(--error); }
  .contact-status.error   .contact-status__text { color: var(--error); }

  /* CTA links */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .contact-links__heading {
    font-size: 9px;
    color: var(--on-surface-variant);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }
  .cta-link { width: 100%; justify-content: center; }

  @media (max-width: 768px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-links { padding-top: 0; }
  }
</style>

<script>
  const form     = document.getElementById('contactForm') as HTMLFormElement;
  const btn      = document.getElementById('submitBtn') as HTMLButtonElement;
  const statusEl = document.getElementById('contactStatus') as HTMLDivElement;
  const statusTx = document.getElementById('statusText') as HTMLSpanElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '[ ··· TRANSMITTING ··· ]';

    const formData = new FormData(form);
    const body = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      statusEl.hidden = false;
      statusEl.className = 'contact-status';
      if (res.ok) {
        statusEl.classList.add('success');
        statusTx.textContent = '✅ MESSAGE SAVED! I will get back to you soon.';
        form.reset();
      } else {
        const errorData = await res.json();
        statusEl.classList.add('error');
        statusTx.textContent = `❌ ${errorData.error || 'TRANSMISSION FAILED. Please try again.'}`;
      }
    } catch {
      statusEl.hidden = false;
      statusEl.classList.add('error');
      statusTx.textContent = '❌ TRANSMISSION FAILED. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = '✉ SEND MESSAGE ▶▶';
    }
  });
</script>
